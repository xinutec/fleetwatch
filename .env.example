# Local dev config for fleetwatch. Copy to .env and `source` it (or use direnv).
# The dev DB comes from scripts/dev-db.sh (127.0.0.1:3307).
export DATABASE_URL=mysql://fleetwatch:fleetwatch@127.0.0.1:3307/fleetwatch
export FLEETWATCH_TEST_DATABASE_URL=mysql://fleetwatch:fleetwatch@127.0.0.1:3307/fleetwatch
# One or more source:token pairs. In production these come from the k8s secret.
export FLEETWATCH_TOKENS=mac-mini:dev-token
# Serve the built Angular bundle from here; unset to run API-only behind ng serve.
# export STATIC_DIR=frontend/dist/fleetwatch-web/browser

# --- Human auth (Nextcloud identity → cookie session) ---
# HMAC key for session cookies. Must be at least 32 chars (the server refuses to
# boot otherwise). Generate one with: openssl rand -hex 32
export SESSION_SECRET=dev-only-session-secret-change-me-1234
# OAuth2 client registered in Nextcloud. Required to boot; only exercised on login.
export NC_BASE_URL=https://dash.xinutec.org
export NC_CLIENT_ID=dev-client-id
export NC_CLIENT_SECRET=dev-client-secret
export NC_REDIRECT_URI=http://localhost:8080/auth/callback
# DEV ONLY: mints a session for this user at /dev-login with no Nextcloud round-trip.
# Leave UNSET in any real deployment — the server refuses to boot if this is set
# while STATIC_DIR (production static serving) is also set.
export DEV_LOGIN_USER=pippijn
