{
  "checks": [
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "fmt",
        "--all",
        "--check"
      ],
      "cwd": ".",
      "env": {},
      "name": "formatting",
      "timeout_s": 180
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "clippy",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "cwd": ".",
      "env": {
        "CARGO_TARGET_DIR": "/Users/pippijn/.cache/cargo/clippy-target"
      },
      "name": "clippy",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "nix",
        "run",
        "../dev-lint#with-test-db",
