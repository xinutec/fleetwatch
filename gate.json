        "--database",
        "fleetwatch",
        "--user",
        "fleetwatch",
        "--password",
        "fleetwatch",
        "--port",
        "3317",
        "--url-env",
        "FLEETWATCH_TEST_DATABASE_URL",
        "--",
        "cargo",
        "test"
      ],
      "cwd": ".",
      "env": {},
      "name": "tests (against a real MariaDB)",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "scripts/gen-types.sh",
