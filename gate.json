        ":app:testDebugUnitTest"
      ],
      "cwd": "android",
      "env": {},
      "name": "android :app unit tests",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "run",
        "../dev-lint#gate",
